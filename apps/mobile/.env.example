# Pillow Thief mobile app environment (copy to .env — never commit real values)
# Supabase project (local dev: values from `supabase start`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps is configured natively via app.json (react-native-maps plugin)
# and requires a development build — it does NOT work in Expo Go.
# See docs/GOOGLE_MAPS.md for key creation + restriction steps.

# Set to "true" to show simulated-payment banners in dev only.
EXPO_PUBLIC_SANDBOX_MODE=true
